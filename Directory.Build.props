<Project>
  <!-- OnderCode Kuaför: ortak ayarlar. Bütün paketler MIT / Apache 2.0; ücretli paket yok. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Abdurrahman Önder</Authors>
    <Company>OnderCode</Company>
    <Product>OnderCode Kuaför</Product>
    <Copyright>© 2026 Abdurrahman Önder</Copyright>
    <Version>1.0.0</Version>
    <!-- NuGet güvenlik uyarıları görünür kalsın ama derlemeyi durdurmasın -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
