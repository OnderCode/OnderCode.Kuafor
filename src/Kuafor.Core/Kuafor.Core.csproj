<Project Sdk="Microsoft.NET.Sdk">
  <!-- Arayüzden bağımsız çekirdek: modeller, randevu kuralları, istatistikler, SQLite veri erişimi, örnek veri. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <!-- sqlite-net (MIT) + yerel SQLite (Apache 2.0). 2.1.13: CVE-2025-6965 düzeltmeli sürüm. -->
    <PackageReference Include="sqlite-net-base" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kuafor.Tests" />
  </ItemGroup>
</Project>
